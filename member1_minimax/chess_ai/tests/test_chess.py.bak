import chess

def best_move(board, depth):
    # Placeholder implementation for best_move
    # Replace this with the actual logic for determining the best move
    return next(iter(board.legal_moves))

def test_mate_in_one():
    b = chess.Board("6k1/5ppp/8/8/8/8/5PPP/R5K1 w - - 0 1")
    assert best_move(b, 1) == chess.Move.from_uci("a1a8")   # Ra8#

def test_takes_free_queen():
    b = chess.Board("4k3/8/8/3q4/8/8/8/3RK3 w - - 0 1")     # Xe ăn Hậu trên cột d
    assert best_move(b, 2) == chess.Move.from_uci("d1d5")

def test_no_illegal_moves():
    b = chess.Board()
    assert best_move(b, 2) in b.legal_moves